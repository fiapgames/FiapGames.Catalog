<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local feed for FiapGames.Contracts versions not yet published to nuget.org.
         Lives inside this repo (not a sibling-repo path) so Docker builds — which only
         see this repo's own content — can resolve it too. Remove this source and the
         .nupkg under local-packages/ once FiapGames.Contracts 1.1.0+ is published for real. -->
    <add key="fiapgames-contracts-local" value="./local-packages" />
  </packageSources>
</configuration>
